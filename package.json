{
  "name": "quaestor",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --workspace-concurrency=1 --if-present lint",
    "test": "pnpm -r --if-present test",
    "gate": "pnpm bytecode:check && pnpm claims:check && pnpm format:check && pnpm typecheck && pnpm lint && pnpm test && pnpm -C contracts test",
    "evidence": "pnpm -C packages/chain exec tsx ../../scripts/evidence.ts",
    "format:check": "prettier --check \"**/*.{ts,tsx}\"",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "bytecode:check": "pnpm -C packages/chain exec tsx ../../scripts/m11-bytecode.ts --check",
    "claims:check": "pnpm -C packages/chain exec tsx ../../scripts/claims.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.65.1",
    "eslint": "9.39.1",
    "prettier": "3.6.2",
    "typescript": "5.6.3",
    "typescript-eslint": "8.46.4"
  },
  "dependencies": {
    "cosmjs-types": "0.11.0",
    "zod": "3.24.2"
  }
}
